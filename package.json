{
  "name": "mdspec",
  "version": "0.4.0",
  "description": "Markdown test runner for CLI docs and shell transcripts. Cram-style console blocks, persistent shell context, pattern matching, and snapshot updates.",
  "keywords": [
    "bash",
    "bun",
    "cli-testing",
    "cram",
    "docs-as-tests",
    "doctest",
    "markdown",
    "markdown-testing",
    "nodejs",
    "shell",
    "snapshot-testing",
    "testing",
    "trycmd"
  ],
  "homepage": "https://mdspec.org/",
  "bugs": {
    "url": "https://github.com/beorn/mdspec/issues"
  },
  "license": "MIT",
  "author": "Beorn",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/mdspec.git"
  },
  "bin": {
    "mdspec": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts",
    "./bun": "./src/integrations/bun.ts",
    "./vitest": "./src/integrations/vitest.ts",
    "./vitest-plugin": "./src/integrations/vitest-plugin.ts",
    "./types": "./src/types.ts",
    "./shell": "./src/shell.ts",
    "./core": "./src/core.ts",
    "./constants": "./src/constants.ts",
    "./cmdSession": "./src/cmdSession.ts",
    "./plugins/bash": "./src/plugins/bash.ts",
    "./plugins/tape": "./src/plugins/tape.ts"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "mdspec": "./dist/index.mjs"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./api": {
        "types": "./dist/api.d.mts",
        "import": "./dist/api.mjs"
      },
      "./bun": {
        "types": "./dist/integrations/bun.d.mts",
        "import": "./dist/integrations/bun.mjs"
      },
      "./vitest": {
        "types": "./dist/integrations/vitest.d.mts",
        "import": "./dist/integrations/vitest.mjs"
      },
      "./vitest-plugin": {
        "types": "./dist/integrations/vitest-plugin.d.mts",
        "import": "./dist/integrations/vitest-plugin.mjs"
      },
      "./types": {
        "types": "./dist/types.d.mts",
        "import": "./dist/types.mjs"
      },
      "./shell": {
        "types": "./dist/shell.d.mts",
        "import": "./dist/shell.mjs"
      },
      "./core": {
        "types": "./dist/core.d.mts",
        "import": "./dist/core.mjs"
      },
      "./constants": {
        "types": "./dist/constants.d.mts",
        "import": "./dist/constants.mjs"
      },
      "./cmdSession": {
        "types": "./dist/cmdSession.d.mts",
        "import": "./dist/cmdSession.mjs"
      },
      "./plugins/bash": {
        "types": "./dist/plugins/bash.d.mts",
        "import": "./dist/plugins/bash.mjs"
      },
      "./plugins/tape": {
        "types": "./dist/plugins/tape.d.mts",
        "import": "./dist/plugins/tape.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "bunx --bun vitest run",
    "typecheck": "tsc --noEmit",
    "ci": "bun run typecheck && bun run test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check-private": "bun scripts/check-private-leak.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "github-slugger": "^2.0.0",
    "glob": "^11.0.0",
    "mdast-util-to-string": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@bearly/vitepress-enrich": "^0.3.0",
    "@silvery/commander": "^0.21.0",
    "@types/bun": "^1.3.12",
    "@types/debug": "^4.1.13",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.6.0",
    "commander": "^14.0.3",
    "loggily": "^0.10.0",
    "tsdown": "^0.22.5",
    "typescript": "latest",
    "vite": "^6.0.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.13.2",
    "vitest": "^4.1.4",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@termless/core": ">=0.3.0",
    "@termless/vt100": ">=0.3.0",
    "node-pty": ">=1.0.0",
    "vitest": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "node-pty": {
      "optional": true
    },
    "@termless/core": {
      "optional": true
    },
    "@termless/vt100": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "tsdown": {
    "clean": true,
    "dts": true,
    "entry": [
      "src/index.ts",
      "src/api.ts",
      "src/integrations/bun.ts",
      "src/integrations/vitest.ts",
      "src/integrations/vitest-plugin.ts",
      "src/types.ts",
      "src/shell.ts",
      "src/core.ts",
      "src/constants.ts",
      "src/cmdSession.ts",
      "src/plugins/bash.ts",
      "src/plugins/tape.ts"
    ],
    "external": [
      "vite",
      "vitest",
      "@termless/core",
      "@termless/vt100",
      "node-pty"
    ],
    "format": "esm"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=23.6.0"
  }
}
